import uk.m4xy.fktests.api.Test
import uk.m4xy.links.domain.*
import uk.m4xy.links.domain.Links.*
import fckt.effects.Fail

@Test @Fail askedNamesAreChecked() = {
  assertEquals(Some("docs"), Slugs.asked("docs").toOption().map { it.text })
  assertEquals(Error(InvalidSlug("ab")), Slugs.asked("ab"))
  assertEquals(Error(InvalidSlug("no spaces")), Slugs.asked("no spaces"))
  assertEquals(Error(InvalidSlug("links")), Slugs.asked("links"))
}

@Test @Fail madeNamesCountInBase62() = {
  assertEquals(["1", "Z", "10", "11"], [1, 61, 62, 63].map { Slugs.made(it, 0).text })
  assertEquals("2-1", Slugs.made(2, 1).text)
}

@Test @Fail onlyHttpUrlsAreTargets() = {
  assertEquals(
    Error(InvalidUrl("ftp://example.com/file")),
    TargetUrls.parsed("ftp://example.com/file"),
  )
  assertEquals(
    Some("https://example.com/a?q=1"),
    TargetUrls.parsed("https://example.com/a?q=1").toOption().map { it.text },
  )
}

@Test @Fail aVisitIsCounted() = when (Slugs.read("a"), TargetUrls.parsed("https://example.com")) {
  (Some(slug), Ok(target)) -> assertEquals(2, Links.created(slug, target).visited().visited().visits)
  _ -> fail("a and https://example.com are a name and a target")
}
