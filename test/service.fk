import uk.m4xy.fktests.api.Test
import uk.m4xy.http.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*
import uk.m4xy.http.json.JsonBodies.*
import uk.m4xy.http.client.Client
import uk.m4xy.http.net.Network
import uk.m4xy.http.server.Routes
import uk.m4xy.http.server.Server
import uk.m4xy.links.infrastructure.SqliteStore
import uk.m4xy.links.presentation.*
import uk.m4xy.links.domain.*
import uk.m4xy.links.application.UnitOfWork
import fckt.effects.Failure.attempt
import uk.m4xy.sql.*
import uk.m4xy.serialization.json.Json
import fckt.effects.Fail
import fckt.text.Encodings.*
import uk.m4xy.http.client.Http

@SqlEngine @Network @Fail service<A>(
  body: @Http @Database () -> A,
): A = Databases.opening(":memory:") {
  SqliteStore.prepare()
  Server.answering(
    Routes.around(LinkRoutes.routes) { respond -> SqliteStore.keeping { respond() } },
  ) { body() }
}

base: String = "http://links.test"

@Http @Fail shorten(
  url: String,
  slug: Option<String> = None,
): Response = postJson("$base/links", ShortenRequestSerializer, ShortenRequest(url, slug))

@Http @Fail delete(
  path: String,
): Response = Client.send(Request(Delete, Client.parsed("$base$path")))

@Fail problemIn(response: Response): String = response.json(ProblemViewSerializer).error

@Test @SqlEngine @Network @Fail aLinkIsMadeAndFollowed() = service {
  made = shorten("https://example.com/a/long/path?q=1")
  assertEquals(created, made.status)
  link = made.json(LinkViewSerializer)
  assertEquals(LinkView("1", "https://example.com/a/long/path?q=1", 0), link)

  followed = Client.get("$base/${link.slug}")
  assertEquals(found, followed.status)
  assertEquals(Some("https://example.com/a/long/path?q=1"), followed.header("Location"))
  Client.get("$base/${link.slug}")

  assertEquals(
    LinkView("1", "https://example.com/a/long/path?q=1", 2),
    Client.get("$base/links/1").json(LinkViewSerializer),
  )
}

@Test @SqlEngine @Network @Fail madeNamesAreBase62() = service {
  (1..63).forEach { n -> shorten("https://example.com/$n") }
  assertEquals(
    ["11", "10", "Z"],
    Client.get("$base/links").json(LinkListViewSerializer).links.take(3).map { it.slug },
  )
}

@Test @SqlEngine @Network @Fail aLinkCanAskForItsName() = service {
  assertEquals(
    LinkView("docs", "https://fckt.dev/docs", 0),
    shorten("https://fckt.dev/docs", Some("docs")).json(LinkViewSerializer),
  )
  taken = shorten("https://elsewhere.dev", Some("docs"))
  assertEquals(conflict, taken.status)
  assertEquals("there's already a link called 'docs'", problemIn(taken))
}

@Test @SqlEngine @Network @Fail aMadeNameStepsAroundOneAskedFor() = service {
  Databases.insert("INSERT INTO links (slug, url) VALUES ('2', 'https://example.com/asked')")
  assertEquals("2-1", shorten("https://example.com/one").json(LinkViewSerializer).slug)
  assertEquals("3", shorten("https://example.com/two").json(LinkViewSerializer).slug)
}

@Test @SqlEngine @Network @Fail whatMayNotBeMadeIsRejected() = service {
  notHttp = shorten("ftp://example.com/file")
  assertEquals(unprocessableContent, notHttp.status)
  assertEquals("'ftp://example.com/file' isn't an http or https URL", problemIn(notHttp))
  assertEquals(unprocessableContent, shorten("https://example.com", Some("no spaces")).status)
  assertEquals(unprocessableContent, shorten("https://example.com", Some("links")).status)
  assertEquals(unprocessableContent, shorten("https://example.com", Some("ab")).status)
}

@Test @SqlEngine @Network @Fail notJsonIsABadRequest() = service {
  assertEquals(
    badRequest,
    Client.post("$base/links", "{\"url\": 3}".encodeToBytes(), "application/json").status,
  )
}

@Test @SqlEngine @Network @Fail deleting() = service {
  shorten("https://example.com", Some("gone"))
  assertEquals(noContent, delete("/links/gone").status)
  assertEquals(notFound, Client.get("$base/gone").status)
  assertEquals("there's no link called 'gone'", problemIn(delete("/links/gone")))
}

@Test @SqlEngine @Network @Fail health() = service {
  assertEquals("ok", Client.get("$base/health").text)
}

@Test @SqlEngine @Fail aFailedTransactionIsRolledBack() = Databases.opening(":memory:") {
  SqliteStore.prepare()
  failed: Result<Unit, String> = attempt {
    SqliteStore.keeping {
      atomically {
        when (Slugs.read("lost"), TargetUrls.parsed("https://example.com")) {
          (Some(slug), Ok(target)) -> add(Links.created(slug, target))
          _ -> Unit
        }
        fail("the store fell over")
      }
    }
  }
  assertEquals(Error("the store fell over"), failed)
  assertEquals([], SqliteStore.keeping { newestFirst() })
}

@Test @SqlEngine @Network @Fail aStoreThatFailsFailsOnlyThatRequest() = service {
  Databases.script("DROP TABLE links")
  assertEquals(internalServerError, Client.get("$base/links").status)
  assertEquals("ok", Client.get("$base/health").text)
}

@Test @SqlEngine @Network @Fail theServiceDescribesItself() = service {
  described = Client.get("$base/openapi.json")
  assertEquals(ok, described.status)
  assertEquals(true, described.text.contains("\"/links/{slug}\":{\"get\":"))
  assertEquals(
    true,
    described.text.contains("\"uk.m4xy.links.presentation.LinkView\":{\"type\":\"object\""),
  )
}

// The home page lists the links, for people, escaping where they go.
@Test @SqlEngine @Network @Fail theHomePageListsTheLinks() = service {
  assertEquals(true, Client.get("$base/").text.contains("No links yet"))
  assertEquals(created, shorten("https://example.com/?a=1&b=2", Some("exa")).status)
  home = Client.get("$base/")
  assertEquals(Some("text/html; charset=utf-8"), home.header("Content-Type"))
  assertEquals(true, home.text.contains("""<a href="/exa"><code>exa</code></a>"""))
  assertEquals(true, home.text.contains(">https://example.com/?a=1&amp;b=2</a>"))
  assertEquals(true, home.text.contains("<td>0 times</td>"))
}
