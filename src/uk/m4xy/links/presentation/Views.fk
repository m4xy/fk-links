import uk.m4xy.links.application.ShortenLink
import uk.m4xy.links.domain.*

module Views {
  link(link: Link): LinkView = LinkView(link.slug.text, link.target.text, link.visits)

  links(links: List<Link>): LinkListView = LinkListView(links.map { link(it) })

  request(asked: ShortenRequest): ShortenLink = ShortenLink(asked.url, asked.slug)
}
