import uk.m4xy.http.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*
import uk.m4xy.http.json.JsonBodies.*
import uk.m4xy.http.server.*
import uk.m4xy.http.server.Endpoints.*
import uk.m4xy.http.server.Inputs.*
import uk.m4xy.http.server.Routes.*
import uk.m4xy.http.openapi.OpenApi
import uk.m4xy.links.application.*
import uk.m4xy.links.domain.*

module LinkRoutes {
  routes: List<Route<@LinkRepository @UnitOfWork>> = endpoints + [
    OpenApi.documenting("/openapi.json", "fk-links", "0.1.0", endpoints),
  ]

  private endpoints: List<Route<@LinkRepository @UnitOfWork>> = [
    get("/health", nothing, health)
      .answering(ok),
    post("/links", body(ShortenRequestSerializer), shortenLink)
      .answeringJson(created, LinkViewSerializer)
      .answeringJson(conflict, ProblemViewSerializer)
      .answeringJson(unprocessableContent, ProblemViewSerializer),
    get("/links", nothing, listLinks)
      .answeringJson(ok, LinkListViewSerializer),
    get("/links/{slug}", slug, showLink)
      .answeringJson(ok, LinkViewSerializer)
      .answeringJson(notFound, ProblemViewSerializer),
    delete("/links/{slug}", slug, deleteLink)
      .answering(noContent)
      .answeringJson(notFound, ProblemViewSerializer),
    get("/{slug}", slug, followLink)
      .answering(found)
      .answeringJson(notFound, ProblemViewSerializer),
  ]

  private slug: Input<String> = param("slug")

  private health(_: Unit): Response = text(ok, "ok")

  private shortenLink(asked: ShortenRequest): Response =
    answering(
      ShortenLink.execute(Views.request(asked)),
    ) { link -> json(created, LinkViewSerializer, Views.link(link)) }

  private listLinks(
    _: Unit,
  ): Response = json(ok, LinkListViewSerializer, Views.links(ListLinks.execute()))

  private showLink(slug: String): Response =
    answering(ShowLink.execute(slug)) { link -> json(ok, LinkViewSerializer, Views.link(link)) }

  private deleteLink(slug: String): Response =
    answering(DeleteLink.execute(slug)) { _ -> Response(noContent) }

  private followLink(slug: String): Response =
    answering(
      FollowLink.execute(slug),
    ) { target -> Response(found, [Header("Location", target.text)]) }

  private answering<A>(
    result: Result<A, LinkProblem>,
    success: (A) -> Response,
  ): Response = when (result) {
    Ok(value) -> success(value)
    Error(problem) -> Problems.response(problem)
  }
}
