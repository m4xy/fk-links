import uk.m4xy.http.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*
import uk.m4xy.http.json.JsonBodies.*
import uk.m4xy.http.server.*
import uk.m4xy.http.server.Endpoints.*
import uk.m4xy.http.server.Inputs.*
import uk.m4xy.links.application.LinkService
import uk.m4xy.links.domain.*

// The service over HTTP: each endpoint, what it reads, and the handler that answers it, which asks
// LinkService and answers with what it says.
module LinkRoutes {
  routes: List<Route<@LinkRepository>> = [
    get("/health", nothing, health),
    post("/links", body(ShortenRequestSerializer), shortenLink),
    get("/links", nothing, listLinks),
    get("/links/{slug}", slug, showLink),
    delete("/links/{slug}", slug, deleteLink),
    get("/{slug}", slug, followLink),
  ]

  // A link's name, from the path.
  private slug: Input<String> = param("slug")

  // 200, if the service is up.
  private health(_: Unit): Response = text(ok, "ok")

  // 201 with the link made; 409 if the name's taken, 422 if it may not be made.
  @LinkRepository private shortenLink(asked: ShortenRequest): Response =
    answering(LinkService.shorten(Views.request(asked))) { link -> json(created, LinkViewSerializer, Views.link(link)) }

  // Every link, the newest first.
  @LinkRepository private listLinks(_: Unit): Response = json(ok, LinkListViewSerializer, Views.links(LinkService.all()))

  // The link, with how many times it's been followed.
  @LinkRepository private showLink(slug: String): Response =
    answering(LinkService.details(slug)) { link -> json(ok, LinkViewSerializer, Views.link(link)) }

  // 204, the link deleted.
  @LinkRepository private deleteLink(slug: String): Response =
    answering(LinkService.delete(slug)) { _ -> Response(noContent) }

  // 302 to where the link leads, the visit counted.
  @LinkRepository private followLink(slug: String): Response =
    answering(LinkService.follow(slug)) { target -> Response(found, [Header("Location", target.text)]) }

  // The response made of what was done, or, if it couldn't be, the problem's.
  private answering<A>(result: Result<A, LinkProblem>, success: (A) -> Response): Response = when (result) {
    Ok(value) -> success(value)
    Error(problem) -> Problems.response(problem)
  }
}
