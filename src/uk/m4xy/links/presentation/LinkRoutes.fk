import fckt.collections.Maps.*
import uk.m4xy.http.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*
import uk.m4xy.http.json.JsonBodies.*
import uk.m4xy.http.server.*
import uk.m4xy.links.application.LinkService
import uk.m4xy.links.domain.*

// The service over HTTP: which route each request takes, then a handler for each, which reads the
// request, asks LinkService, and answers with what it says.
module LinkRoutes {
  routes: List<Route<@LinkRepository>> = [
    Route(Get, "/health", health),
    Route(Post, "/links", shortenLink),
    Route(Get, "/links", listLinks),
    Route(Get, "/links/{slug}", showLink),
    Route(Delete, "/links/{slug}", deleteLink),
    Route(Get, "/{slug}", followLink),
  ]

  // 200, if the service is up.
  private health(call: Call): Response = text(ok, "ok")

  // {"url": ..., "slug": ...}: 201 with the link made; 409 if the name's taken, 422 if it may not be
  // made.
  @LinkRepository private shortenLink(call: Call): Response = receiving(call, ShortenRequestSerializer) { asked ->
    answering(LinkService.shorten(Views.request(asked))) { link -> json(created, LinkViewSerializer, Views.link(link)) }
  }

  // Every link, the newest first.
  @LinkRepository private listLinks(call: Call): Response = json(ok, LinkListViewSerializer, Views.links(LinkService.all()))

  // The link, with how many times it's been followed.
  @LinkRepository private showLink(call: Call): Response =
    answering(LinkService.details(slugIn(call))) { link -> json(ok, LinkViewSerializer, Views.link(link)) }

  // 204, the link deleted.
  @LinkRepository private deleteLink(call: Call): Response =
    answering(LinkService.delete(slugIn(call))) { _ -> Response(noContent) }

  // 302 to where the link leads, the visit counted.
  @LinkRepository private followLink(call: Call): Response =
    answering(LinkService.follow(slugIn(call))) { target -> Response(found, [Header("Location", target.text)]) }

  // The response made of what was done, or, if it couldn't be, the problem's.
  private answering<A>(result: Result<A, LinkProblem>, success: (A) -> Response): Response = when (result) {
    Ok(value) -> success(value)
    Error(problem) -> Problems.response(problem)
  }

  private slugIn(call: Call): String = call.params.get("slug").getOrElse("")
}
