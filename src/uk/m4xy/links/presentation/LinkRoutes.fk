import uk.m4xy.http.*
import uk.m4xy.http.Messages.*
import uk.m4xy.http.Statuses.*
import uk.m4xy.http.json.JsonBodies.*
import uk.m4xy.http.server.*
import uk.m4xy.http.server.Endpoints.*
import uk.m4xy.http.server.Inputs.*
import uk.m4xy.links.application.*
import uk.m4xy.links.domain.*

module LinkRoutes {
  routes: List<Route<@LinkRepository @UnitOfWork>> = [
    get("/health", nothing, health),
    post("/links", body(ShortenRequestSerializer), shortenLink),
    get("/links", nothing, listLinks),
    get("/links/{slug}", slug, showLink),
    delete("/links/{slug}", slug, deleteLink),
    get("/{slug}", slug, followLink),
  ]

  private slug: Input<String> = param("slug")

  private health(_: Unit): Response = text(ok, "ok")

  @LinkRepository @UnitOfWork private shortenLink(asked: ShortenRequest): Response =
    answering(ShortenLink.execute(Views.request(asked))) { link -> json(created, LinkViewSerializer, Views.link(link)) }

  @LinkRepository @UnitOfWork private listLinks(_: Unit): Response = json(ok, LinkListViewSerializer, Views.links(ListLinks.execute()))

  @LinkRepository @UnitOfWork private showLink(slug: String): Response =
    answering(ShowLink.execute(slug)) { link -> json(ok, LinkViewSerializer, Views.link(link)) }

  @LinkRepository @UnitOfWork private deleteLink(slug: String): Response =
    answering(DeleteLink.execute(slug)) { _ -> Response(noContent) }

  @LinkRepository @UnitOfWork private followLink(slug: String): Response =
    answering(FollowLink.execute(slug)) { target -> Response(found, [Header("Location", target.text)]) }

  private answering<A>(result: Result<A, LinkProblem>, success: (A) -> Response): Response = when (result) {
    Ok(value) -> success(value)
    Error(problem) -> Problems.response(problem)
  }
}
