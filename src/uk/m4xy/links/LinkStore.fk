import fckt.effects.Fail
import uk.m4xy.sql.*
import uk.m4xy.sql.Columns.*
import uk.m4xy.sql.Databases.*

// Links, kept in the database's links table.
module LinkStore {
  // Makes the table, if it isn't there.
  @Database @Fail prepare(): Unit = script(
    "CREATE TABLE IF NOT EXISTS links (id INTEGER PRIMARY KEY, slug TEXT UNIQUE, url TEXT NOT NULL, visits INTEGER NOT NULL DEFAULT 0)"
  )

  // Makes the link, with the name it asks for, or one made for it: or, if it asks for a name that's
  // taken, says so.
  @Database @Fail create(link: NewLink): Result<Link, Rejection> = transaction {
    when (link.slug) {
      Some(slug) -> if (find(slug).isSome()) Error(SlugTaken(slug)) else {
        insert("INSERT INTO links (slug, url) VALUES (?, ?)", [Text(slug), Text(link.url)])
        Ok(Link(slug, link.url, 0))
      }
      None -> {
        id = insert("INSERT INTO links (url) VALUES (?)", [Text(link.url)])
        slug = freeSlug(id, 0)
        execute("UPDATE links SET slug = ? WHERE id = ?", [Text(slug), Integer(id)])
        Ok(Link(slug, link.url, 0))
      }
    }
  }

  @Database @Fail find(slug: String): Option<Link> = queryOne(links, "SELECT slug, url, visits FROM links WHERE slug = ?", [Text(slug)])

  // Every link, newest first.
  @Database @Fail all(): List<Link> = queryAs(links, "SELECT slug, url, visits FROM links ORDER BY id DESC")

  // Counts a visit to the link, and gives where it leads, if there's such a link.
  @Database @Fail visit(slug: String): Option<String> =
    if (execute("UPDATE links SET visits = visits + 1 WHERE slug = ?", [Text(slug)]) == 0) None
    else find(slug).map { it.url }

  // Deletes the link, and says whether there was one.
  @Database @Fail remove(slug: String): Boolean = execute("DELETE FROM links WHERE slug = ?", [Text(slug)]) > 0

  @Database @Fail private freeSlug(id: Int, tries: Int): String = {
    slug = Shortening.madeSlug(id, tries)
    if (find(slug).isSome()) freeSlug(id, tries + 1) else slug
  }

  private links: Column<Link> = Columns {
    slug by text("slug")
    url by text("url")
    visits by int("visits")
    Link(slug, url, visits)
  }
}
