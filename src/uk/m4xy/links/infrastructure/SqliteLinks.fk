import fckt.effects.Fail
import uk.m4xy.links.application.UnitOfWork
import uk.m4xy.links.domain.*
import uk.m4xy.sql.*
import uk.m4xy.sql.Columns.*
import uk.m4xy.sql.Databases.*

module SqliteLinks {
  @Database @Fail prepare(): Unit = script(
    "CREATE TABLE IF NOT EXISTS links (id INTEGER PRIMARY KEY, slug TEXT UNIQUE NOT NULL, url TEXT NOT NULL, visits INTEGER NOT NULL DEFAULT 0)"
  )

  @Database @Fail keeping<A>(body: @LinkRepository @UnitOfWork () -> A): A = LinkRepository(
    linkNamed = slug -> queryOne(rows, "SELECT slug, url, visits FROM links WHERE slug = ?", [Text(slug.text)]).map { linkOf(it) },
    newestFirst = () -> queryAs(rows, "SELECT slug, url, visits FROM links ORDER BY id DESC").map { linkOf(it) },
    nextNumber = () -> queryOne(numbers, "SELECT COALESCE(MAX(id), 0) + 1 AS next FROM links").getOrElse(1),
    add = link -> {
      insert("INSERT INTO links (slug, url, visits) VALUES (?, ?, ?)", [Text(link.slug.text), Text(link.target.text), Integer(link.visits)])
      Unit
    },
    replace = link -> {
      execute("UPDATE links SET url = ?, visits = ? WHERE slug = ?", [Text(link.target.text), Integer(link.visits), Text(link.slug.text)])
      Unit
    },
    remove = slug -> execute("DELETE FROM links WHERE slug = ?", [Text(slug.text)]) > 0,
  ) {
    UnitOfWork(atomically = work -> transaction { work() }) { body() }
  }

  private type Row(slug: String, url: String, visits: Int)

  private rows: Column<Row> = Columns {
    slug by text("slug")
    url by text("url")
    visits by int("visits")
    Row(slug, url, visits)
  }

  private numbers: Column<Int> = int("next")

  @Fail private linkOf(row: Row): Link = when (Slugs.read(row.slug), TargetUrls.parsed(row.url)) {
    (Some(slug), Ok(target)) -> Link(slug, target, row.visits)
    _ -> fail("the links table has a row the service couldn't have made: ${row.slug} -> ${row.url}")
  }
}
