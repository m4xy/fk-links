import uk.m4xy.links.domain.*

@LinkMemory module InMemoryLinks : LinkRepository {
  linkNamed(slug: Slug): Option<Link> = stored().newestFirst.find { it.slug == slug }

  newestFirst(): List<Link> = stored().newestFirst

  nextNumber(): Int = stored().made + 1

  add(link: Link): Unit = {
    links = stored()
    store(StoredLinks([link, *links.newestFirst], links.made + 1))
  }

  replace(link: Link): Unit = {
    links = stored()
    store(
      links.copy(newestFirst = links.newestFirst.map { if (it.slug == link.slug) link else it }),
    )
  }

  remove(slug: Slug): Boolean = {
    links = stored()
    kept = links.newestFirst.filter { it.slug != slug }
    store(links.copy(newestFirst = kept))
    kept.size < links.newestFirst.size
  }
}
