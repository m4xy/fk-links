import uk.m4xy.regex.*
import uk.m4xy.regex.Regexes.*

module Slugs {
  asked(text: String): Result<Slug, LinkProblem> =
    if (askable.matches(text) && !reserved.contains(text)) Ok(Slug(text)) else Error(
      InvalidSlug(text),
    )

  read(text: String): Option<Slug> = if (any.matches(text)) Some(Slug(text)) else None

  made(
    number: Int,
    attempt: Int,
  ): Slug = Slug(if (attempt == 0) base62(number) else "${base62(number)}-$attempt")

  reserved: List<String> = ["links", "health"]

  private askable: Regex = Patterns.compiled("[A-Za-z0-9_-]{3,32}")

  private any: Regex = Patterns.compiled("[A-Za-z0-9_-]{1,40}")

  private digits: String = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

  private base62(n: Int): String =
    if (n < 62) digits.toList().getOrNone(n).map { it.toString() }.getOrElse("")
    else base62(n / 62) + base62(n % 62)
}
