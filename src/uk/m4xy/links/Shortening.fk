import uk.m4xy.regex.*
import uk.m4xy.regex.Regexes.*

// What a link may be, and the names made for links that don't ask for one. Nothing here touches the
// database.
module Shortening {
  // The link, if it may be made, or why not; that its name is free, only the database can say.
  checked(link: NewLink): Result<NewLink, Rejection> =
    if (!urls.matches(link.url)) Error(InvalidUrl(link.url))
    else when (link.slug) {
      Some(slug) if !slugs.matches(slug) || reserved.contains(slug) -> Error(InvalidSlug(slug))
      _ -> Ok(link)
    }

  // The name made for the link with the row ID, its ID in base 62, or, if a link asked for that name
  // itself, with a count after it: the first of these that's free.
  madeSlug(id: Int, tries: Int): String = if (tries == 0) base62(id) else "${base62(id)}-$tries"

  // Names the service's own paths have.
  reserved: List<String> = ["links", "health"]

  private urls: Regex = compiled("https?://[^\\s/?#]+[^\\s]*")

  private slugs: Regex = compiled("[A-Za-z0-9_-]{3,32}")

  private digits: String = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

  private base62(n: Int): String =
    if (n < 62) digits.toList().getOrNone(n).map { it.toString() }.getOrElse("")
    else base62(n / 62) + base62(n % 62)

  // A pattern written here, which is one: if it weren't, this module would be wrong, not its input.
  private compiled(pattern: String): Regex = when (regex(pattern)) {
    Ok(r) -> r
    Error(e) -> error("/$pattern/ isn't a pattern: ${e.message}")
  }
}
